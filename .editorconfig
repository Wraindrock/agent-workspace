root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
indent_size = 2
switch_case_indent = true

[*.{md,markdown}]
trim_trailing_whitespace = false

[Justfile]
indent_style = space
indent_size = 4

[*.{toml,env,conf}]
indent_size = 2
