# Module metadata consumed by build_files/build.sh.
# Values are quoted: this file is sourced by bash, so an unquoted value
# containing spaces would be executed as a command.
MODULE_NAME="20-container-tools"
MODULE_DESCRIPTION="Rootless container runtime and OCI tooling (podman, buildah, skopeo)"
# 1 = applied unless config/modules.conf or IMAGE_MODULES says otherwise
MODULE_ENABLED_DEFAULT=1
