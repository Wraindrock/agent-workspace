# ---------------------------------------------------------------------------
# agent-workspace - image identity and build parameters
# ---------------------------------------------------------------------------
# This file is the single source of truth for "who this image is". It is read
# by the Justfile (dotenv), by .github/workflows/*.yml (sourced by bash) and is
# passed to the Containerfile as build arguments, then baked into the image
# manifest at /usr/share/agent-workspace/manifest.json.
#
# Values are quoted on purpose: the workflows source this file, so an unquoted
# value with spaces would be parsed as a command. tests/lint.sh enforces this.
# ---------------------------------------------------------------------------

# Image name - must match the GitHub repository name.
IMAGE_NAME="agent-workspace"

# GitHub user or organisation that owns the repository and the image.
REPO_ORGANIZATION="Wraindrock"

IMAGE_DESC="A declarative, rollback-capable Fedora bootc system container for running coding agents and general-purpose agents"
IMAGE_KEYWORDS="agent,bootc,oci,linux,podman,universal-blue,developer-tooling"
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
IMAGE_LICENSE="MIT"

# Default tag published by CI. install.sh pulls "<image>:latest" unless --image
# (or IMAGE_OVERRIDE) says otherwise.
DEFAULT_TAG="latest"

# Base image. Universal Blue images are cosign-signed Fedora bootc images.
# Alternatives:
#   ghcr.io/ublue-os/base-main:gts      slower-moving Fedora base (recommended for fleets)
#   ghcr.io/ublue-os/bluefin:stable     GNOME desktop base
#   ghcr.io/ublue-os/aurora:stable      KDE desktop base
#   quay.io/fedora/fedora-bootc:44      vanilla Fedora bootc
BASE_IMAGE="ghcr.io/ublue-os/base-main:latest"

# Unprivileged user that owns the agent workspaces. Created on first boot if
# it does not already exist. Set to an existing base-image user to reuse it.
AGENT_USER="agent"
