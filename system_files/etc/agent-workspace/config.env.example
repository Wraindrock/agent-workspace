# ---------------------------------------------------------------------------
# Per-machine configuration for agent-workspace.
#
#   sudo cp /etc/agent-workspace/config.env.example /etc/agent-workspace/config.env
#   sudoedit /etc/agent-workspace/config.env
#
# This file is read by agent-workspace-firstboot.service and by the
# agent-workspace CLI. bootc merges /etc three ways, so an edit here survives
# image updates - which is exactly why machine-specific values belong here and
# not in a build module.
#
# Everything is optional: the values below are the built-in defaults.
# ---------------------------------------------------------------------------

# Unprivileged user that owns agent workspaces. Created on first boot.
# AGENT_WORKSPACE_USER=agent

# Login shell for that user.
# AGENT_WORKSPACE_SHELL=/bin/bash
